<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a stack of exposures with a sun, on the 108dp canvas
     (72dp safe zone). Represents merging bracketed frames into one HDR image. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- back frame -->
    <path
        android:fillColor="#4DFFFFFF"
        android:pathData="M32,30 h44 a4,4 0 0 1 4,4 v40 a4,4 0 0 1 -4,4 h-44 a4,4 0 0 1 -4,-4 v-40 a4,4 0 0 1 4,-4 z" />
    <!-- middle frame -->
    <path
        android:fillColor="#99FFFFFF"
        android:pathData="M36,36 h44 a4,4 0 0 1 4,4 v40 a4,4 0 0 1 -4,4 h-44 a4,4 0 0 1 -4,-4 v-40 a4,4 0 0 1 4,-4 z" />
    <!-- front frame -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,42 h44 a4,4 0 0 1 4,4 v40 a4,4 0 0 1 -4,4 h-44 a4,4 0 0 1 -4,-4 v-40 a4,4 0 0 1 4,-4 z" />
    <!-- sun in the front frame -->
    <path
        android:fillColor="#FFF2A900"
        android:pathData="M54,58 m-7,0 a7,7 0 1 0 14,0 a7,7 0 1 0 -14,0 z" />
    <!-- horizon / mountain in the front frame -->
    <path
        android:fillColor="#FF0B3D4C"
        android:pathData="M40,90 v-8 l14,-14 l10,10 l12,-12 l8,8 v16 z" />
</vector>
