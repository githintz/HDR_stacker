<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debugging variant: request synchronous MTE heap tagging where the
         hardware supports it (silently ignored elsewhere). Catches native
         heap overflows with a precise tombstone, complementing the
         guard-page allocator linked into the decoder. -->
    <application android:memtagMode="sync" />
</manifest>
